---
import { profile } from '../data/profile';
import { yearsAcross } from '../lib/time';

const years = Math.floor(yearsAcross([[profile.careerStart, 'present']]));
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden pt-16 pb-10"
  style="background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 50%, var(--sky-low) 85%);"
>
  <!-- Painted, animated highlands: see src/scripts/scene.ts (sky gradient above is the no-JS fallback) -->
  <canvas id="hero-scene" class="pointer-events-none absolute inset-0 -z-20 h-full w-full" aria-hidden="true"></canvas>

  <!-- Soft veil behind the wordmark, and a fade into the page -->
  <div class="pointer-events-none absolute inset-0 -z-10" style="background: radial-gradient(ellipse 50% 38% at 50% 42%, color-mix(in srgb, var(--hero-fade) 45%, transparent), transparent 75%);"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-32" style="background: linear-gradient(transparent, var(--hero-fade));"></div>

  <!-- Wordmark -->
  <div class="relative mx-auto max-w-5xl px-4 text-center sm:px-6">
    <p class="hero-halo font-display text-[0.7rem] tracking-[0.3em] text-aether uppercase sm:text-sm sm:tracking-[0.5em]">The Supply Chain Chronicles</p>

    <h1 class="mt-4 font-display leading-none font-bold tracking-[0.06em] uppercase">
      <span class="title-text block text-[clamp(2.6rem,10vw,7.5rem)]">{profile.name.split(' ')[0]}</span>
      <span class="title-text block text-[clamp(2.2rem,8.5vw,6.25rem)]">{profile.name.split(' ').slice(1).join(' ')}</span>
    </h1>

    <div class="divider"><span></span></div>

    <!-- Frosted plate keeps the copy readable over the painted mountains -->
    <div class="hero-plate mx-auto mt-6 max-w-3xl px-5 py-5 sm:px-8">
      <p class="font-serif text-base leading-relaxed text-ink-strong sm:text-lg md:text-xl">{profile.headline}</p>
      <p class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 border-t border-frost/30 pt-4 font-display text-[0.7rem] tracking-[0.25em] text-frost-light uppercase sm:text-xs">
        <span>Current Expansion</span>
        <span class="text-aether">◆</span>
        <span class="text-ink-strong">{profile.currentExpansion}</span>
        <span class="hidden text-aether sm:inline">◆</span>
        <span class="w-full sm:w-auto">{years}+ years of adventuring</span>
      </p>
    </div>

    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="#character" class="btn btn-gold w-full max-w-xs sm:w-auto">Begin Your Journey</a>
      <a href="#party" class="btn btn-ghost w-full max-w-xs sm:w-auto">Join the Party</a>
    </div>
  </div>
</section>

<script>
  import { startScene } from '../scripts/scene';
  const canvas = document.getElementById('hero-scene') as HTMLCanvasElement;
  startScene(canvas, document.getElementById('top')!);
</script>
