---
// Snowstorm overlay: a heavy blizzard inside the hero, a light drift over the rest of the page.
// One fixed canvas above the content (pointer-events: none); skipped for reduced-motion users.
---

<canvas id="snow" class="pointer-events-none fixed inset-0 z-40 h-full w-full" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('snow') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  type Flake = { x: number; y: number; r: number; vy: number; vx: number; phase: number; a: number };
  let w = 0, h = 0, dpr = 1;
  let storm: Flake[] = [];
  let drift: Flake[] = [];
  let snow = '235 243 255';
  let edge = '235 243 255';
  let raf = 0;
  let last = performance.now();

  const hero = document.getElementById('top');

  const make = (heavy: boolean): Flake => ({
    x: Math.random() * w,
    y: Math.random() * h,
    r: heavy ? 0.8 + Math.random() * 2.6 : 0.6 + Math.random() * 1.6,
    vy: heavy ? 60 + Math.random() * 110 : 18 + Math.random() * 30,
    vx: heavy ? 70 + Math.random() * 120 : 6 + Math.random() * 14,
    phase: Math.random() * Math.PI * 2,
    a: heavy ? 0.45 + Math.random() * 0.5 : 0.25 + Math.random() * 0.35,
  });

  function readColors() {
    const cs = getComputedStyle(document.documentElement);
    snow = cs.getPropertyValue('--snow').trim() || snow;
    edge = cs.getPropertyValue('--snow-edge').trim() || edge;
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    const area = w * h;
    storm = Array.from({ length: Math.min(340, Math.round(area / 3200)) }, () => make(true));
    drift = Array.from({ length: Math.min(70, Math.round(area / 22000)) }, () => make(false));
  }

  function step(list: Flake[], dt: number, t: number, gust: number) {
    for (const f of list) {
      f.y += f.vy * dt;
      f.x += (f.vx * gust + Math.sin(t * 0.0012 + f.phase) * 18) * dt;
      if (f.y > h + 6) { f.y = -6; f.x = Math.random() * w; }
      if (f.x > w + 6) f.x = -6;
      if (f.x < -6) f.x = w + 6;
    }
  }

  function draw(list: Flake[], rgb: string) {
    for (const f of list) {
      ctx!.globalAlpha = f.a;
      ctx!.fillStyle = `rgb(${rgb})`;
      ctx!.beginPath();
      ctx!.arc(f.x, f.y, f.r, 0, Math.PI * 2);
      ctx!.fill();
    }
    ctx!.globalAlpha = 1;
  }

  function frame(t: number) {
    const dt = Math.min((t - last) / 1000, 0.05);
    last = t;
    const gust = 0.7 + 0.5 * Math.sin(t * 0.00035) + 0.25 * Math.sin(t * 0.0011);
    ctx!.clearRect(0, 0, w, h);

    // Blizzard, clipped to the visible part of the hero
    const r = hero?.getBoundingClientRect();
    if (r && r.bottom > 0) {
      step(storm, dt, t, gust);
      ctx!.save();
      ctx!.beginPath();
      ctx!.rect(0, Math.max(0, r.top), w, Math.min(h, r.bottom) - Math.max(0, r.top));
      ctx!.clip();
      draw(storm, snow);
      ctx!.restore();
    }
    // Gentle snowfall everywhere
    step(drift, dt, t, 0.4 + gust * 0.3);
    draw(drift, edge);

    raf = requestAnimationFrame(frame);
  }

  function start() {
    cancelAnimationFrame(raf);
    if (!ctx || reduce.matches || document.hidden) {
      ctx?.clearRect(0, 0, w, h);
      return;
    }
    last = performance.now();
    raf = requestAnimationFrame(frame);
  }

  readColors();
  resize();
  start();
  window.addEventListener('resize', resize);
  document.addEventListener('visibilitychange', start);
  reduce.addEventListener('change', start);
  // Re-read flake colours when the theme changes (switch or OS setting)
  new MutationObserver(readColors).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readColors);
</script>
