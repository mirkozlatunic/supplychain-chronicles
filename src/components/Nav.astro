---
import { profile } from '../data/profile';

const links = [
  { href: '#character', label: 'Character' },
  { href: '#jobs', label: 'Jobs' },
  { href: '#quests', label: 'Quest Log' },
  { href: '#achievements', label: 'Achievements' },
  { href: '#linguist', label: 'Linguist' },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-gold/25 data-[scrolled]:bg-abyss/90 data-[scrolled]:backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:h-20" aria-label="Main">
    <a href="#top" class="group flex items-center gap-3" aria-label="Back to top">
      <span
        class="grid size-9 rotate-45 place-items-center border border-gold/70 bg-night shadow-[0_0_16px_rgb(216_178_90/0.3)] transition group-hover:shadow-[0_0_24px_rgb(216_178_90/0.6)]"
      >
        <span class="-rotate-45 font-display text-sm font-bold text-gold-light">{profile.initials}</span>
      </span>
      <span class="hidden font-display text-sm leading-tight tracking-[0.2em] text-parchment uppercase sm:block">
        Supply Chain<br /><span class="text-gold">Chronicles</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="relative px-4 py-2 font-display text-xs tracking-[0.2em] text-parchment/80 uppercase transition hover:text-gold-light after:absolute after:inset-x-4 after:-bottom-0.5 after:h-px after:origin-center after:scale-x-0 after:bg-gold after:transition hover:after:scale-x-100"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a href="#party" class="btn btn-gold hidden !px-5 !py-2.5 !text-xs sm:inline-flex">Join the Party</a>
      <button
        id="nav-toggle"
        type="button"
        class="grid size-11 place-items-center border border-gold/40 text-gold-light lg:hidden"
        aria-controls="nav-panel"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path class="nav-open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="nav-close hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-panel" class="hidden border-t border-gold/25 bg-abyss/95 backdrop-blur-md lg:hidden">
    <ul class="mx-auto flex max-w-7xl flex-col px-4 py-4 sm:px-6">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex items-center gap-3 border-b border-line/60 py-4 font-display tracking-[0.2em] text-parchment uppercase hover:text-gold-light"
            >
              <span class="size-1.5 rotate-45 bg-aether shadow-[0_0_8px_var(--color-aether)]" />
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="pt-5">
        <a href="#party" class="btn btn-gold w-full">Join the Party</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('nav-panel')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24 || !panel.classList.contains('hidden'));
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    panel.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.nav-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.nav-close')!.classList.toggle('hidden', !open);
    onScroll();
  };
  toggle.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
  panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
