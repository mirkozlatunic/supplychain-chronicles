---
import { profile } from '../data/profile';

const links = [
  { href: '#character', label: 'Character' },
  { href: '#jobs', label: 'Jobs' },
  { href: '#quests', label: 'Quest Log' },
  { href: '#achievements', label: 'Achievements' },
  { href: '#linguist', label: 'Linguist' },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-frost/25 data-[scrolled]:bg-ground/90 data-[scrolled]:backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:h-20" aria-label="Main">
    <a href="#top" class="group flex items-center gap-3" aria-label="Back to top">
      <span
        class="grid size-9 rotate-45 place-items-center border border-frost/70 bg-surface shadow-[0_0_16px_rgb(var(--frost-rgb)/0.3)] transition group-hover:shadow-[0_0_24px_rgb(var(--frost-rgb)/0.6)]"
      >
        <span class="-rotate-45 font-display text-sm font-bold text-frost-light">{profile.initials}</span>
      </span>
      <span class="hidden font-display text-sm leading-tight tracking-[0.2em] text-ink-strong uppercase sm:block">
        Supply Chain<br /><span class="text-frost">Chronicles</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="relative px-4 py-2 font-display text-xs tracking-[0.2em] text-ink-strong/80 uppercase transition hover:text-frost-light after:absolute after:inset-x-4 after:-bottom-0.5 after:h-px after:origin-center after:scale-x-0 after:bg-frost after:transition hover:after:scale-x-100"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a href="#party" class="btn btn-gold hidden !px-5 !py-2.5 !text-xs sm:inline-flex">Join the Party</a>
      <button
        id="theme-toggle"
        type="button"
        class="hidden size-11 place-items-center border border-frost/40 text-frost-light transition hover:bg-frost/10 [.js_&]:grid"
        aria-label="Switch theme"
        title="Switch theme"
      >
        <!-- moon: shown in dark theme -->
        <svg class="theme-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"></path>
        </svg>
        <!-- sun behind snow: shown in light theme -->
        <svg class="theme-sun hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
        </svg>
      </button>
      <button
        id="nav-toggle"
        type="button"
        class="grid size-11 place-items-center border border-frost/40 text-frost-light lg:hidden"
        aria-controls="nav-panel"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path class="nav-open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="nav-close hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-panel" class="hidden border-t border-frost/25 bg-ground/95 backdrop-blur-md lg:hidden">
    <ul class="mx-auto flex max-w-7xl flex-col px-4 py-4 sm:px-6">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex items-center gap-3 border-b border-line/60 py-4 font-display tracking-[0.2em] text-ink-strong uppercase hover:text-frost-light"
            >
              <span class="size-1.5 rotate-45 bg-aether shadow-[0_0_8px_var(--color-aether)]" />
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="pt-5">
        <a href="#party" class="btn btn-gold w-full">Join the Party</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('nav-panel')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24 || !panel.classList.contains('hidden'));
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    panel.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.nav-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.nav-close')!.classList.toggle('hidden', !open);
    onScroll();
  };
  toggle.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
  panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Theme switch: follows the OS until the visitor picks one, then remembers it.
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle')!;
  const darkOS = matchMedia('(prefers-color-scheme: dark)');
  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (darkOS.matches ? 'dark' : 'light');
  const paintToggle = () => {
    const theme = current();
    const label = theme === 'dark' ? 'Switch to daylight snowstorm (light theme)' : 'Switch to night blizzard (dark theme)';
    themeBtn.setAttribute('aria-label', label);
    themeBtn.title = label;
    themeBtn.querySelector('.theme-moon')!.classList.toggle('hidden', theme !== 'dark');
    themeBtn.querySelector('.theme-sun')!.classList.toggle('hidden', theme === 'dark');
  };
  const applyTheme = (next: 'light' | 'dark') => {
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: the choice lasts for this visit only */
    }
    paintToggle();
  };
  themeBtn.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return applyTheme(next);

    // Preferred: the new theme spreads out in a circle from the switch (View Transitions API)
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };
    if (doc.startViewTransition) {
      const r = themeBtn.getBoundingClientRect();
      const x = r.left + r.width / 2, y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      doc.startViewTransition(() => applyTheme(next)).ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 900, easing: 'cubic-bezier(.4,0,.2,1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
      return;
    }
    // Fallback: cross-fade every colour for a moment
    root.classList.add('theme-fade');
    applyTheme(next);
    setTimeout(() => root.classList.remove('theme-fade'), 750);
  });
  darkOS.addEventListener('change', paintToggle);
  paintToggle();
</script>
