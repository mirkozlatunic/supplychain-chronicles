---
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const channels = [
  { label: 'Send a Tell', sub: profile.email, href: `mailto:${profile.email}`, icon: 'mail' as const },
  { label: 'LinkedIn', sub: 'linkedin.com/in/mirkozlatunic', href: profile.linkedin, icon: 'link' as const },
  { label: 'GitHub', sub: 'github.com/mirkozlatunic', href: profile.github, icon: 'github' as const },
];
---

<section id="party" class="relative overflow-hidden px-4 py-24 sm:px-6 md:py-32">
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 60% 70% at 50% 100%, rgb(111 211 255 / 0.18), transparent 70%), radial-gradient(ellipse 80% 60% at 50% 0%, rgb(216 178 90 / 0.08), transparent 70%);"
  >
  </div>
  <div class="reveal mx-auto max-w-4xl text-center">
    <p class="font-display text-xs tracking-[0.45em] text-aether uppercase">Party Finder</p>
    <h2 class="gold-text mt-3 font-display text-4xl tracking-[0.1em] uppercase sm:text-6xl">Join the Party</h2>
    <div class="divider"><span></span></div>
    <p class="mx-auto mt-6 max-w-2xl font-serif text-lg leading-relaxed text-parchment/90">{profile.seeking}</p>

    <ul class="mt-12 grid gap-4 sm:grid-cols-3">
      {
        channels.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.href.startsWith('http') ? '_blank' : undefined}
              rel={c.href.startsWith('http') ? 'noopener' : undefined}
              class="frame shine group flex h-full flex-col items-center gap-3 p-6 transition hover:-translate-y-1 hover:border-gold/70"
            >
              <span class="shine-sweep" />
              <span class="grid size-12 place-items-center rounded-full border border-gold/60 text-gold-light group-hover:shadow-[0_0_20px_rgb(216_178_90/0.5)]">
                <Icon name={c.icon} />
              </span>
              <span class="font-display tracking-[0.15em] text-parchment uppercase">{c.label}</span>
              <span class="text-xs break-all text-mist/80">{c.sub}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
