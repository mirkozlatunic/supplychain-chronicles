---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="border-t border-frost/20 bg-ground px-4 py-10 text-center sm:px-6">
  <div class="divider !mt-0 mb-6"><span></span></div>
  <p class="font-display text-sm tracking-[0.3em] text-ink-strong uppercase">The Supply Chain Chronicles</p>
  <p class="mt-3 text-xs text-ink/70">© {year} {profile.name}. All rights reserved.</p>
  <p class="mx-auto mt-2 max-w-xl text-[0.7rem] leading-relaxed text-ink/50">
    A fan-made, MMORPG-inspired portfolio with a snowbound, dragon-haunted theme. Not affiliated with or endorsed by Square Enix; all artwork is original.
  </p>
  <a href="#top" class="mt-6 inline-block font-display text-xs tracking-[0.25em] text-frost uppercase hover:text-frost-light">Return to Top ▴</a>
</footer>
