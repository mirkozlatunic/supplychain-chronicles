---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section id="linguist" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 md:py-32">
  <SectionHeading eyebrow="Tongues of the Realm" title="Linguist" />
  <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      profile.languages.map((l, i) => (
        <li class="frame reveal flex flex-col items-center p-5 text-center sm:p-6" style={`transition-delay:${i * 70}ms`}>
          <span class="font-display text-xl tracking-[0.1em] text-parchment sm:text-2xl">{l.name}</span>
          <span class="mt-3 flex gap-1 text-lg sm:text-xl" role="img" aria-label={`${l.stars} of 5 stars`}>
            {Array.from({ length: 5 }, (_, s) => (
              <span class={s < l.stars ? 'text-gold drop-shadow-[0_0_6px_rgb(216_178_90/0.7)]' : 'text-line'}>★</span>
            ))}
          </span>
          <span class="mt-2 text-xs tracking-[0.15em] uppercase">{l.level}</span>
        </li>
      ))
    }
  </ul>
</section>
