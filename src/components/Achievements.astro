---
import { achievements } from '../data/profile';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const total = achievements.reduce((s, a) => s + a.points, 0);
---

<section id="achievements" class="relative py-24 md:py-32">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-transparent via-surface/40 to-transparent"></div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading eyebrow="Accolades" title="Achievements" />

    <div class="reveal mx-auto -mt-6 mb-12 flex w-fit items-center gap-4 border-y border-frost/30 px-6 py-3">
      <Icon name="star" class="size-6 text-gold" />
      <span class="font-display text-xs tracking-[0.25em] uppercase">Achievement Points</span>
      <span class="gold-text font-display text-3xl font-bold">{total}</span>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        achievements.map((a, i) => (
          <li class="frame shine reveal flex items-center gap-4 p-4 transition hover:-translate-y-0.5" style={`transition-delay:${(i % 3) * 60}ms`}>
            <span class="shine-sweep" />
            <span class="grid size-14 shrink-0 place-items-center border border-frost/60 bg-gradient-to-br from-frost-dark/40 to-ground text-frost-light shadow-[inset_0_0_12px_rgb(var(--frost-rgb)/0.25)]">
              <Icon name={a.icon} class="size-7" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-display text-base leading-snug text-ink-strong">{a.title}</span>
              <span class="block text-sm leading-snug">{a.detail}</span>
            </span>
            <span class="shrink-0 text-right">
              <span class="block font-display text-xl text-gold">{a.points}</span>
              <span class="block text-[0.65rem] text-ink/70">{a.year}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
