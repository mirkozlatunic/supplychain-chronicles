---
import { expansions, jobs, profile } from '../data/profile';
import { formatDuration, levelFor, yearsAcross } from '../lib/time';
import SectionHeading from './SectionHeading.astro';

const bachem = expansions.flatMap((e) => e.quests).filter((q) => q.org === 'Bachem');
const bachemStart = bachem.map((q) => q.start).sort()[0];
const current = expansions.at(-1)!.quests[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const avgLevel = Math.round(
  jobs.reduce((sum, j) => sum + levelFor(yearsAcross(j.ranges)), 0) / jobs.length,
);

const stats = [
  { label: 'Name', value: profile.name },
  { label: 'Title', value: profile.shortTitle },
  { label: 'Current Job', value: current.title },
  { label: 'Home World', value: profile.location },
  { label: 'Grand Company', value: `Bachem · ${formatDuration(bachemStart, 'present')}` },
  { label: 'Free Company', value: 'github.com/mirkozlatunic', href: profile.github },
];
---

<section id="character" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32">
  <SectionHeading eyebrow="The Lodestone" title="Character Profile" />

  <div class="frame reveal grid gap-0 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <!-- Portrait / crest -->
    <div class="relative flex flex-col items-center justify-center gap-6 overflow-hidden border-b lg:justify-start lg:pt-16 border-frost/20 p-8 sm:p-10 lg:border-r lg:border-b-0">
      <div class="absolute inset-0 -z-0 opacity-60" style="background: radial-gradient(circle at 50% 40%, rgb(var(--aether-rgb) / 0.18), transparent 60%);"></div>
      <!-- Character portrait, framed like an in-game character card -->
      <figure class="portrait relative w-full max-w-sm">
        <div class="portrait-frame relative aspect-[4/5] overflow-hidden">
          <img
            src={`${base}/img/portrait-800.webp`}
            srcset={`${base}/img/portrait-480.webp 480w, ${base}/img/portrait-800.webp 800w`}
            sizes="(min-width: 1024px) 24rem, (min-width: 640px) 24rem, 90vw"
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
            alt={`${profile.name} portrayed as a samurai under a full moon, katana resting on his shoulder`}
            class="absolute inset-0 h-full w-full object-cover object-top"
          />
          <!-- frost grade + fade into the nameplate -->
          <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(180deg, rgb(var(--aether-rgb) / 0.08), transparent 35%, transparent 55%, color-mix(in srgb, var(--t-ground) 92%, transparent) 100%);"></div>
          <div class="pointer-events-none absolute inset-0 shadow-[inset_0_0_60px_rgb(var(--shade-rgb)/0.45)]"></div>
          <!-- crest badge -->
          <span class="absolute top-4 left-4 grid size-11 rotate-45 place-items-center border border-frost/70 bg-ground/80 backdrop-blur-sm">
            <span class="title-text -rotate-45 font-display text-sm font-bold">{profile.initials}</span>
          </span>
          <!-- nameplate -->
          <figcaption class="absolute inset-x-0 bottom-0 px-5 pt-10 pb-5 text-center">
            <span class="block font-display text-lg tracking-[0.1em] whitespace-nowrap text-ink-strong [text-shadow:var(--halo)] sm:text-2xl sm:tracking-[0.12em]">{profile.name}</span>
            <span class="mt-1 block font-display text-xs tracking-[0.3em] text-frost-light uppercase [text-shadow:var(--halo)]">Warrior of Supply</span>
          </figcaption>
        </div>
      </figure>
      <div class="relative grid w-full max-w-xs grid-cols-2 gap-3 text-center">
        <div class="border border-frost/25 bg-surface/70 px-3 py-3 shadow-[inset_0_0_16px_rgb(var(--aether-rgb)/0.06)]">
          <p class="font-display text-2xl text-frost-light">{avgLevel}</p>
          <p class="text-[0.65rem] tracking-[0.2em] uppercase">Avg. Job Lv</p>
        </div>
        <div class="border border-frost/25 bg-surface/70 px-3 py-3 shadow-[inset_0_0_16px_rgb(var(--aether-rgb)/0.06)]">
          <p class="font-display text-2xl text-frost-light">{jobs.length}</p>
          <p class="text-[0.65rem] tracking-[0.2em] uppercase">Jobs Unlocked</p>
        </div>
      </div>
    </div>

    <!-- Details -->
    <div class="p-6 sm:p-10">
      <dl class="grid gap-x-8 sm:grid-cols-2">
        {
          stats.map((s) => (
            <div class="flex flex-col gap-1 border-b border-line/70 py-3">
              <dt class="font-display text-[0.65rem] tracking-[0.25em] text-frost uppercase">{s.label}</dt>
              <dd class="text-ink-strong">
                {s.href ? <a class="underline decoration-frost/40 underline-offset-4 hover:text-frost-light" href={s.href} target="_blank" rel="noopener">{s.value}</a> : s.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <h3 class="mt-8 font-display text-sm tracking-[0.3em] text-frost-light uppercase">Biography</h3>
      <div class="mt-3 space-y-4 font-serif leading-relaxed text-ink-strong/85">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="mt-8 font-display text-sm tracking-[0.3em] text-frost-light uppercase">Attributes</h3>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          profile.strengths.map((s) => (
            <li class="flex gap-3 text-sm leading-snug">
              <span class="mt-1.5 size-1.5 shrink-0 rotate-45 bg-aether shadow-[0_0_6px_var(--color-aether)]" />
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
